{
  "compilerOptions": {
   
    "target": "es2016", 
    "module": "commonjs", 
    "outDir": "./build",     
    "forceConsistentCasingInFileNames": true,  
    "strict": true,    
    "skipLibCheck": true  ,
    "esModuleInterop": true,  
    "typeRoots": [
      "node_modules/@types",
      "src/types" // Add this line if you're using a custom types directory
    ]                          
  }
}
